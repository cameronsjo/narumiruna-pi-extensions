{
	"name": "@narumitw/pi-herdr",
	"version": "0.0.1",
	"description": "Herdr agent-state integration and operating skill for Pi.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"herdr",
		"terminal-multiplexer",
		"agent-orchestration"
	],
	"files": [
